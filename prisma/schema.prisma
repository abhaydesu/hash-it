datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Platform {
  LEETCODE
  GFG
  OTHER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SolveStatus {
  SOLVED_UNAIDED
  SOLVED_WITH_HELP
  ATTEMPTED_FAILED
}

enum Rating {
  AGAIN
  HARD
  GOOD
  EASY
}

/// Which Today-queue lane an attempt was logged from. Null for attempts made
/// outside the daily queue (initial logs, monthly mocks) — those never count
/// against the daily caps.
enum ReviewLane {
  RECALL
  RESOLVE
}

enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/// How sure the user was before revealing their notes in the weekly recall check.
enum RecallConfidence {
  BLANK
  HAZY
  CLEAR
}

enum PlanItemKind {
  REDO
  FRESH
  REVISIT
}

enum PatternSource {
  SHEET
  USER
}

model Problem {
  id           String      @id @default(cuid())
  platform     Platform
  slug         String
  number       Int?
  title        String
  url          String
  difficulty   Difficulty?
  acRate       Float?
  isPaidOnly   Boolean     @default(false)
  topicTags    String[]
  lastSyncedAt DateTime?

  patterns     ProblemPattern[]
  entries      Entry[]
  roadmapItems RoadmapItem[]
  planItems    WeeklyPlanItem[]

  @@unique([platform, slug])
  @@index([number])
}

model Pattern {
  id        String @id @default(cuid())
  name      String @unique
  family    String
  sortOrder Int

  problems ProblemPattern[]
}

model ProblemPattern {
  problemId String
  patternId String
  source    PatternSource @default(SHEET)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@id([problemId, patternId])
}

model Entry {
  id              String      @id @default(cuid())
  userId          String
  problemId       String
  status          SolveStatus
  idea            String?
  mistake         String?
  sourceList      String?
  minutes         Int?
  revisit         Boolean     @default(false)
  firstSolvedAt   DateTime
  patternOverride String[]
  topic           String?
  customUrl       String?
  customPattern   String?
  /// Values for the user's own columns, keyed by CustomFieldDef.id (see lib/custom-fields.ts).
  customValues    Json?
  importBatchId   String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem      Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  attempts     Attempt[]
  reviewCard   ReviewCard?
  weeklyChecks WeeklyCheck[]
  importBatch  ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([userId, problemId])
  @@index([userId])
}

model Attempt {
  id       String   @id @default(cuid())
  entryId  String
  at       DateTime @default(now())
  rating   Rating
  minutes  Int?
  usedHint Boolean  @default(false)
  note     String?
  lane     ReviewLane?

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([at])
}

model ReviewCard {
  entryId       String    @id
  due           DateTime
  stability     Float
  difficulty    Float
  elapsedDays   Int
  scheduledDays Int
  reps          Int
  lapses        Int
  state         CardState
  lastReview    DateTime?

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([due])
}

model UserSettings {
  userId           String  @id
  dailyResolveCap  Int     @default(2)
  desiredRetention Float   @default(0.80)
  fsrsParams       Float[]
  timezone         String  @default("Asia/Kolkata")
  easyBaseline     Int     @default(20)
  mediumBaseline   Int     @default(40)
  hardBaseline     Int     @default(60)
  /// User-defined columns: CustomFieldDef[] (see lib/custom-fields.ts).
  customFields     Json?
  /// Per-user stats page layout: which sections are visible + display order.
  statsPreferences Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ImportBatch {
  id         String   @id @default(cuid())
  userId     String
  createdAt  DateTime @default(now())
  filename   String?
  entryCount Int
  status     String   @default("COMMITTED")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries Entry[]

  @@index([userId])
}

// NextAuth Models
model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  entries       Entry[]
  weeklyChecks  WeeklyCheck[]
  weeklyPlans   WeeklyPlan[]
  monthlyMocks  MonthlyMock[]
  settings      UserSettings?
  importBatches ImportBatch[]
  /// Set when the user answers "Nothing to import" on the /today banner; new sign-ups only see it until then.
  importPromptDismissedAt DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Separate Study Roadmap (e.g. YouTuber DSA Patterns Sheet)
model RoadmapPattern {
  id    String        @id @default(cuid())
  name  String        @unique
  order Int
  items RoadmapItem[]

  createdAt DateTime @default(now())
}

model RoadmapItem {
  id                 String   @id @default(cuid())
  roadmapPatternId   String
  title              String
  primaryUrl         String?
  additionalUrls     String[] @default([])
  order              Int
  canonicalProblemId String?

  roadmapPattern   RoadmapPattern @relation(fields: [roadmapPatternId], references: [id], onDelete: Cascade)
  canonicalProblem Problem?       @relation(fields: [canonicalProblemId], references: [id], onDelete: SetNull)

  @@index([roadmapPatternId])
  @@index([canonicalProblemId])
}

/// One weekly recall check: confidence tapped before reveal, then whether the user had it.
/// `weekStart` is the local Monday (YYYY-MM-DD) in the user's timezone.
model WeeklyCheck {
  id         String           @id @default(cuid())
  userId     String
  entryId    String
  weekStart  String
  at         DateTime         @default(now())
  confidence RecallConfidence
  recalled   Boolean

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, weekStart])
  @@index([userId, weekStart])
}

/// The problems a user committed to for the coming week. Completion is derived from attempts.
model WeeklyPlan {
  id        String   @id @default(cuid())
  userId    String
  weekStart String
  createdAt DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WeeklyPlanItem[]

  @@unique([userId, weekStart])
}

model WeeklyPlanItem {
  id        String       @id @default(cuid())
  planId    String
  kind      PlanItemKind
  problemId String

  plan    WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  problem Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([planId, kind])
}

/// A completed monthly mock. `period` (YYYY-MM) is the month it counts for: mocks open on
/// the month's last local day, and each completion credits the earliest month still owed.
model MonthlyMock {
  id          String   @id @default(cuid())
  userId      String
  period      String
  /// Client session id, so a finished session reloaded from storage can't be recorded twice.
  sessionId   String   @unique
  completedAt DateTime @default(now())
  solved      Int
  hinted      Int
  failed      Int
  durationSec Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
}
