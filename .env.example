# Neon pooled connection string (use the -pooler host for serverless/Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="dev-secret-replace-with-openssl-rand-base64-32" # Required always; ≥16 chars in production
AUTH_URL="https://your-production-domain.vercel.app" # Production canonical URL (Auth.js)
NEXTAUTH_URL="https://your-production-domain.vercel.app" # Legacy alias; keep in sync with AUTH_URL
AUTH_TRUST_HOST="true" # Allow Auth.js to trust the Host header behind Vercel
AUTH_GOOGLE_ID="" # Required in production (Google OAuth client ID)
AUTH_GOOGLE_SECRET="" # Required in production (Google OAuth client secret)
CRON_SECRET="" # Shared secret for cron endpoints (required for /api/cron/*)
